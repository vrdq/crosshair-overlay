        self.spin_off_y.setValue(0)
        self.slider_off_y.setValue(0)
        self.cfg["offset_x"] = 0
        self.cfg["offset_y"] = 0
        self.updating_ui = False
        self.commit()

    def choose_color(self):
        cur = QColor(self.cfg.get("color", "#3DDBD9"))
        col = QColorDialog.getColor(cur, self, "Reticle Color")
        if col.isValid():
            self.cfg["color"] = col.name().upper()
            self.update_color_buttons()
            self.commit()

    def choose_outline_color(self):
        cur = QColor(self.cfg.get("outline_color", "#000000"))
        col = QColorDialog.getColor(cur, self, "Outline Color")
        if col.isValid():
            self.cfg["outline_color"] = col.name().upper()
            self.update_color_buttons()
            self.commit()

    def commit(self):
        self.canvas.set_config(self.cfg)
        save_config(self.cfg)

    def update_status(self):
        is_running, pid = get_process_status()
        self.is_running = is_running

        if is_running:
            self.lbl_status.setText(f"Daemon: active (PID {pid})")
            self.lbl_status.setStyleSheet("color: #42be65; font-size: 12px;")
            self.btn_toggle.setText("Stop")
        else:
            self.lbl_status.setText("Daemon: stopped")
            self.lbl_status.setStyleSheet("color: #666666; font-size: 12px;")
            self.btn_toggle.setText("Start")

    def on_toggle_clicked(self):
        bin_path = find_crosshair_bin()
        self.btn_toggle.setEnabled(False)

        if self.is_running:
            subprocess.run([bin_path, "stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.run([bin_path, "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        QTimer.singleShot(100, self.update_status)
        QTimer.singleShot(250, lambda: [self.update_status(), self.btn_toggle.setEnabled(True)])

    def on_reload_clicked(self):
        bin_path = find_crosshair_bin()
        subprocess.run([bin_path, "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.update_status()


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("crosshair")
    win = CrosshairSettingsDialog()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
