CONFIG_DIR = Path.home() / ".config" / "crosshair"
CONFIG_FILE = CONFIG_DIR / "config"

DEFAULT_CONFIG = {
    "shape": "dot",
    "size": 4.0,
    "color": "#3DDBD9",
    "outline": 1.0,
    "outline_color": "#000000",
    "opacity": 1.0,
    "offset_x": 0,
    "offset_y": 0,
    "gap": 3,
    "length": 6,
    "thickness": 2,
    "monitor": "all",
}


def find_crosshair_bin():
    which_bin = shutil.which("crosshair")
    if which_bin:
        return which_bin

    candidates = [
        Path.home() / ".local/bin/crosshair",
        Path("/usr/local/bin/crosshair"),
        Path("/usr/bin/crosshair"),
        Path(__file__).resolve().parent / "src/crosshair",
        Path(__file__).resolve().parent / "crosshair",
    ]
    for c in candidates:
        if c.is_file() and os.access(c, os.X_OK):
            return str(c)

    return "crosshair"


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    if not CONFIG_FILE.exists():
        return cfg
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith(("#", ";")):
                    continue
                if "=" in line:
                    k, v = [part.strip() for part in line.split("=", 1)]
                    k = k.lower()
                    if k in ("size", "outline", "opacity"):
                        cfg[k] = float(v)
                    elif k in ("offset_x", "offset_y", "gap", "length", "thickness"):
                        cfg[k] = int(v)
                    elif k in ("shape", "color", "outline_color", "monitor"):
                        cfg[k] = v
    except Exception as err:
        print(f"Error reading config: {err}", file=sys.stderr)
    return cfg


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = [
        "# Crosshair Overlay Configuration",
        f"shape = {cfg.get('shape', 'dot')}",
        f"size = {cfg.get('size', 4.0):.1f}",
        f"color = {cfg.get('color', '#3DDBD9')}",
        f"outline = {cfg.get('outline', 1.0):.1f}",
        f"outline_color = {cfg.get('outline_color', '#000000')}",
        f"opacity = {cfg.get('opacity', 1.0):.2f}",
        f"offset_x = {int(cfg.get('offset_x', 0))}",
        f"offset_y = {int(cfg.get('offset_y', 0))}",
        f"gap = {int(cfg.get('gap', 3))}",
        f"length = {int(cfg.get('length', 6))}",
        f"thickness = {int(cfg.get('thickness', 2))}",
        f"monitor = {cfg.get('monitor', 'all')}",
    ]
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")

    bin_path = find_crosshair_bin()
    subprocess.run([bin_path, "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def get_process_status():
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    pid_file = Path(xdg_runtime) / "crosshair.pid" if xdg_runtime else Path(f"/tmp/crosshair-{os.getuid()}.pid")
    if pid_file.exists():
        try:
            pid_str = pid_file.read_text(encoding="utf-8").strip()
            if pid_str.isdigit():
                pid = int(pid_str)
                proc_dir = Path(f"/proc/{pid}")
                if proc_dir.exists():
                    try:
                        cmdline = (proc_dir / "cmdline").read_bytes().decode("utf-8", errors="ignore")
                        if "crosshair" in cmdline:
                            return True, pid
                    except Exception:
                        if proc_dir.exists():
                            return True, pid
        except Exception:
            pass

    try:
        res = subprocess.run(["pgrep", "-x", "crosshair"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            pids = [int(p) for p in res.stdout.strip().split() if p.isdigit()]
            my_pid = os.getpid()
            for p in pids:
                if p != my_pid:
                    return True, p
    except Exception:
        pass

    return False, None


class PreviewWidget(QFrame):
    """Pure pixel preview of reticle. No fake axes, ticks, or decorations."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFixedSize(160, 160)
        self.cfg = dict(DEFAULT_CONFIG)

    def set_config(self, cfg):
        self.cfg = dict(cfg)
        self.update()

    def paintEvent(self, event):
        super().paintEvent(event)
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        rect = self.contentsRect()
        cx = rect.center().x()
        cy = rect.center().y()

        painter.fillRect(rect, QColor("#141414"))
        painter.setPen(QPen(QColor("#242424"), 1))
        painter.setBrush(Qt.BrushStyle.NoBrush)
        painter.drawRect(rect.adjusted(0, 0, -1, -1))

        shape = self.cfg.get("shape", "dot")
        size = float(self.cfg.get("size", 4.0))
        outline = float(self.cfg.get("outline", 1.0))
        opacity = float(self.cfg.get("opacity", 1.0))
        gap = int(self.cfg.get("gap", 3))
        length = int(self.cfg.get("length", 6))
        thickness = max(1.0, float(self.cfg.get("thickness", 2)))

        col = QColor(self.cfg.get("color", "#3DDBD9"))
        col.setAlphaF(min(1.0, max(0.0, opacity)))

        out_col = QColor(self.cfg.get("outline_color", "#000000"))
        out_col.setAlphaF(min(1.0, max(0.0, opacity)))

        if shape == "dot":
            radius = size / 2.0
            if outline > 0:
                painter.setPen(Qt.PenStyle.NoPen)
                painter.setBrush(QBrush(out_col))
                painter.drawEllipse(QPointF(cx, cy), radius + outline, radius + outline)
            painter.setBrush(QBrush(col))
            painter.drawEllipse(QPointF(cx, cy), radius, radius)

        elif shape == "ring":
            radius = size / 2.0
            th = thickness if thickness else 2.0
            if outline > 0:
                painter.setPen(QPen(out_col, th + outline * 2.0))
                painter.setBrush(Qt.BrushStyle.NoBrush)
                painter.drawEllipse(QPointF(cx, cy), radius, radius)
            painter.setPen(QPen(col, th))
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawEllipse(QPointF(cx, cy), radius, radius)

        elif shape == "dot-ring":
            radius = size / 2.0
            th = thickness if thickness else 1.5
            if outline > 0:
                painter.setPen(QPen(out_col, th + outline * 2.0))
                painter.setBrush(Qt.BrushStyle.NoBrush)
                painter.drawEllipse(QPointF(cx, cy), radius, radius)
            painter.setPen(QPen(col, th))
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawEllipse(QPointF(cx, cy), radius, radius)

            dot_r = 1.5
            if outline > 0:
                painter.setPen(Qt.PenStyle.NoPen)
                painter.setBrush(QBrush(out_col))
                painter.drawEllipse(QPointF(cx, cy), dot_r + outline, dot_r + outline)
            painter.setBrush(QBrush(col))
            painter.drawEllipse(QPointF(cx, cy), dot_r, dot_r)

        elif shape in ("cross", "cross-dot"):
            bars = [
                (cx - gap - length, cy - thickness / 2.0, length, thickness),
                (cx + gap, cy - thickness / 2.0, length, thickness),
                (cx - thickness / 2.0, cy - gap - length, thickness, length),
                (cx - thickness / 2.0, cy + gap, thickness, length),
            ]
            if outline > 0:
                painter.setPen(Qt.PenStyle.NoPen)
                painter.setBrush(QBrush(out_col))
                for bx, by, bw, bh in bars:
                    painter.drawRect(QRectF(bx - outline, by - outline, bw + outline * 2.0, bh + outline * 2.0))

            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QBrush(col))
            for bx, by, bw, bh in bars:
                painter.drawRect(QRectF(bx, by, bw, bh))

            if shape == "cross-dot":
                dot_r = (thickness / 2.0) if thickness > 2 else 1.5
                if outline > 0:
                    painter.setPen(Qt.PenStyle.NoPen)
                    painter.setBrush(QBrush(out_col))
                    painter.drawEllipse(QPointF(cx, cy), dot_r + outline, dot_r + outline)
                painter.setBrush(QBrush(col))
                painter.drawEllipse(QPointF(cx, cy), dot_r, dot_r)


