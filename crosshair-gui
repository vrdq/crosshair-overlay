        if self.updating_ui: return
        self.cfg["monitor"] = self.combo_monitor.currentData()
        self.commit()

    def reset_offsets(self):
        self.updating_ui = True
        self.spin_off_x.setValue(0)
        self.slider_off_x.setValue(0)
        self.spin_off_y.setValue(0)
        self.slider_off_y.setValue(0)
        self.cfg["offset_x"] = 0
        self.cfg["offset_y"] = 0
        self.combo_preset.setCurrentText("Custom")
        self.updating_ui = False
        self.commit()

    def choose_color(self):
        cur = QColor(self.cfg.get("color", "#3DDBD9"))
        col = QColorDialog.getColor(cur, self, "Select Reticle Color")
        if col.isValid():
            self.apply_color(col.name().upper())

    def choose_outline_color(self):
        cur = QColor(self.cfg.get("outline_color", "#000000"))
        col = QColorDialog.getColor(cur, self, "Select Outline Color")
        if col.isValid():
            self.apply_outline_color(col.name().upper())

    def commit(self):
        self.canvas.set_config(self.cfg)
        save_config(self.cfg)

    def show_feedback(self, msg):
        self.lbl_feedback.setText(msg)
        QTimer.singleShot(1800, lambda: self.lbl_feedback.setText(""))

    def update_status(self):
        is_running, pid = get_process_status()
        self.is_running = is_running
        self.current_pid = pid

        if is_running:
            self.status_pill.setStyleSheet("""
                QFrame {
                    background-color: #14281a;
                    border: 1px solid #234b2f;
                    border-radius: 15px;
                }
            """)
            self.status_dot.setStyleSheet("color: #42be65;")
            self.status_text.setText(f"ACTIVE • {pid}")
            self.status_text.setStyleSheet("color: #42be65; font-size: 11px; font-weight: 700;")

            self.btn_toggle.setText("Stop Overlay")
            self.btn_toggle.setObjectName("stopAction")
            self.btn_toggle.style().unpolish(self.btn_toggle)
            self.btn_toggle.style().polish(self.btn_toggle)
        else:
            self.status_pill.setStyleSheet("""
                QFrame {
                    background-color: #1c1c1c;
                    border: 1px solid #282828;
                    border-radius: 15px;
                }
            """)
            self.status_dot.setStyleSheet("color: #666666;")
            self.status_text.setText("STANDBY")
            self.status_text.setStyleSheet("color: #808080; font-size: 11px; font-weight: 700;")

            self.btn_toggle.setText("Start Overlay")
            self.btn_toggle.setObjectName("primaryAction")
            self.btn_toggle.style().unpolish(self.btn_toggle)
            self.btn_toggle.style().polish(self.btn_toggle)

    def on_toggle_clicked(self):
        bin_path = find_crosshair_bin()
        self.btn_toggle.setEnabled(False)

        if self.is_running:
            self.btn_toggle.setText("Stopping...")
            subprocess.run([bin_path, "stop"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            self.btn_toggle.setText("Starting...")
            subprocess.run([bin_path, "start"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # Multi-stage check to handle process fork stabilization
        QTimer.singleShot(100, self.update_status)
        QTimer.singleShot(250, self.update_status)
        QTimer.singleShot(400, lambda: [self.update_status(), self.btn_toggle.setEnabled(True)])

    def on_reload_clicked(self):
        bin_path = find_crosshair_bin()
        subprocess.run([bin_path, "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.show_feedback("Settings reloaded")
        self.update_status()


def main():
    app = QApplication(sys.argv)
    app.setDesktopFileName("crosshair")
    win = CrosshairSettingsDialog()
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
